# ~/.config/rrsrch/engine.env on Spark (chmod 600). The ledger listens on 127.0.0.1 only.
RRSRCH_DATABASE_URL=postgresql://rrsrch:rrsrch@127.0.0.1:5434/rrsrch
RRSRCH_LLM_URL=http://127.0.0.1:11434/v1
RRSRCH_READER_MODEL=qwen3.8:27b-q4_K_M
RRSRCH_CORS_ORIGIN=*
PYTHONUNBUFFERED=1
# Seconds per model call. Answers run as jobs, so nothing waits on the connection; a 27B model on one GPU
# shared with the reader needs several minutes.
RRSRCH_LLM_TIMEOUT=900
# Discovery: the public base URL pages are announced under, and the IndexNow key (the site serves the same key at
# https://rrsrch.com/<key>.txt from its INDEXNOW_KEY). Unset: the IndexNow queue fills but nothing is sent.
RRSRCH_PUBLIC_URL=https://rrsrch.com
# RRSRCH_INDEXNOW_KEY=

# Security-domain features (commit evidence, claim kinds, per-kind overrides, non-clinical profiles):
#   off (default) | operator (network admins, private repositories only) | on (public launch). See trust/features.py.
RRSRCH_SECURITY_FEATURES=off
# Bounties (docs/BOUNTIES.md): off (default; every bounty call refuses) | operator (only in private repositories, for
# the pilot) | on. RRSRCH_BOUNTY_IMPETUS=on shows accepted submissions as an Impetus measure, once calibrated.
RRSRCH_BOUNTIES=off
RRSRCH_BOUNTY_IMPETUS=off

# The reader agent (rrsrch-reader-agent.service) reads its own key from ~/.config/rrsrch/reader-agent.env
# (RRSRCH_API_KEY, chmod 600), never from this file: the API process shouldn't hold an agent's key.
