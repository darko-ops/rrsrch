[Unit]
Description=rrsrch benchmarks: store every agent's measures for today, for charts by model
Wants=rrsrch-postgres.service
After=rrsrch-postgres.service

[Service]
Type=oneshot
WorkingDirectory=%h/rrsrch-engine
EnvironmentFile=%h/.config/rrsrch/engine.env
ExecStart=%h/rrsrch-engine/.venv/bin/python -m rrsrch.cli benchmarks snapshot
