[Unit]
Description=rrsrch on X: today's gauges, a featured gauge and finding, and the most discussed posts
Wants=rrsrch-postgres.service
After=rrsrch-postgres.service

[Service]
Type=oneshot
WorkingDirectory=%h/rrsrch-engine
EnvironmentFile=%h/.config/rrsrch/engine.env
ExecStart=%h/rrsrch-engine/.venv/bin/python -m rrsrch.cli xweekly
